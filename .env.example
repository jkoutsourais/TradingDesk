# Copy to .env and fill in real values. .env is git-ignored and must never be committed.

# Postgres (used by deploy/postgres.compose.yml and by the Python services)
POSTGRES_USER=desk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=desk
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# API
API_HOST=127.0.0.1
API_PORT=8000

# tastytrade OAuth (my.tastytrade.com > Manage > My Profile > API > OAuth Applications)
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=

# Finnhub (finnhub.io dashboard)
FINNHUB_API_KEY=

# FRED (fred.stlouisfed.org > My Account > API Keys)
FRED_API_KEY=

# EIA (eia.gov/opendata > Register)
EIA_API_KEY=

# SEC EDGAR fair-access User-Agent: "<name> <contact email>"
SEC_USER_AGENT=

# IBKR Flex Web Service (Client Portal > Performance & Reports > Flex Queries)
FLEX_QUERY_API_TOKEN=
FLEX_QUERY_ID=

# PJM Data Miner API key (free registration at dataminer2.pjm.com); PJM grid data is skipped until set
PJM_API_KEY=

# Temporary remote dev dashboard login (Caddy basic auth on the Beelink)
DEV_DASHBOARD_USER=jon
DEV_DASHBOARD_PASSWORD=
